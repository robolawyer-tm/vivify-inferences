#!/bin/bash
# run_round_trip — decode a stripped coordinate encoding back into prose via claude -p
# One half of the round-trip loss test: encoder = operators (already run), decoder = this.
#
# Auto mode (no options):
#   For each tier input given, prepend decoder_prompt.txt and pipe to claude -p.
#   tier_a_input.json  ->  regen_tier_a.md
#
# Usage:
#   run_round_trip [options] tier_a_input.json [tier_b_input.json ...]
#
# Options:
#   -n, --dry-run      Show the assembled prompt without calling the model
#   -h, --help         Show this help
#
# Examples:
#   run_round_trip tier_a_input.json
#   run_round_trip -n tier_b_input.json
#
# NOTE: claude -p inherits the CLI default model — set /model (or `claude
# config`) to the model you want decoding done by BEFORE running.

EXP_DIR="$(dirname "$(realpath "$0")")"
PROMPT_FILE="$EXP_DIR/decoder_prompt.txt"
date_stamp=$(date +"%Y%m%d-%H%M%S")

usage() {
    echo "Usage: $(basename $0) [options] tier_input.json [tier_input.json ...]"
    echo
    echo "Auto mode: prepend decoder_prompt.txt to each tier input, pipe to claude -p,"
    echo "  write the blind reconstruction next to the input:"
    echo "  tier_a_input.json -> regen_tier_a.md"
    echo
    echo "Options:"
    echo "  -n, --dry-run      Show the assembled prompt without calling the model"
    echo "  -h, --help         Show this help"
    echo
    echo "Examples:"
    echo "  $(basename $0) tier_a_input.json"
    echo "  $(basename $0) -n tier_b_input.json"
    exit 1
}

# Parse arguments
dry_run=false
items=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -n|--dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            items+=("$1")
            shift
            ;;
    esac
done

# Validate
if [ ${#items[@]} -eq 0 ]; then
    usage
fi
if [ ! -f "$PROMPT_FILE" ]; then
    echo "Error: decoder prompt not found: $PROMPT_FILE"
    exit 1
fi

# Main logic
for item in "${items[@]}"; do
    abs_item=$(realpath "$item" 2>/dev/null)
    if [ $? -ne 0 ] || [ ! -e "$abs_item" ]; then
        echo "Error: $item does not exist. Skipping."
        continue
    fi

    base=$(basename "$abs_item" .json)          # tier_a_input
    tier="${base%_input}"                        # tier_a
    out_file="$(dirname "$abs_item")/regen_${tier}.md"

    if $dry_run; then
        echo "=== would send ($abs_item -> $out_file) ==="
        cat "$PROMPT_FILE" "$abs_item"
        continue
    fi

    echo "decoding $base -> $(basename "$out_file") ..."
    cat "$PROMPT_FILE" "$abs_item" | claude -p > "$out_file"
    echo "  done ($(wc -w < "$out_file") words)"
done

